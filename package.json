{
	"name": "bike-mechanic-pad",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"autoprefixer": "^10.6.2",
		"postcss": "^8.5.32",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@sqlite.org/sqlite-wasm": "^3.54.1-build1"
	}
}
